# Copy to .env. All optional: DarkLens runs fully offline without any of these.
ABUSECH_AUTH_KEY=
HIBP_API_KEY=
RANSOMWARE_LIVE_BASE=https://api.ransomware.live/v2
DARKLENS_DB=darklens.db
# Web addresses allowed to call the API from a browser (comma separated, no trailing slash).
# Leave empty unless the web app is hosted on a different address than the API.
ALLOWED_ORIGINS=
